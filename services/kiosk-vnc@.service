[Unit]
Description=VNC mirror of the kiosk display
After=kiosk-browser@%i.service
Wants=kiosk-browser@%i.service
ConditionPathExists=/usr/bin/x11vnc

[Service]
Type=simple
User=%i
EnvironmentFile=/etc/pi-kiosk/kiosk.env
WorkingDirectory=/home/%i
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/%i/.Xauthority
ExecStart=/usr/local/bin/launch_vnc.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
