# Copy this to /etc/pi-kiosk/kiosk.env and tweak as needed.

# Home Assistant dashboard/view URL to load in Chromium.
# Use the exact URL you want from Home Assistant's address bar.
# Examples:
#   - Separate dashboard with URL path "kiosk": https://homeassistant.local:8123/kiosk
#   - View on the default dashboard: https://homeassistant.local:8123/lovelace/living_room
HA_BASE_URL="https://homeassistant.local:8123/kiosk"
# Optional extra query params appended to the URL.
# kiosk=true is for kiosk-mode UI; auto_reload=true is for kiosk-auto-reload.
HA_EXTRA_QUERY="kiosk=true&auto_reload=true&browser_id=pidisplay"

# Runtime user + display configuration.
KIOSK_USER="kiosk"
DISPLAY=":0"
XAUTHORITY="/home/kiosk/.Xauthority"

# Chromium launch flags appended in addition to the defaults in launch_kiosk.sh.
CHROMIUM_FLAGS="--enable-features=OverlayScrollbar"
# Optionally override the Chromium binary (auto-detected if left blank).
# CHROMIUM_BIN="/usr/bin/chromium"
# Browser color scheme handling: auto, light, dark, or schedule.
CHROMIUM_COLOR_SCHEME="schedule"
# Shared day/night schedule for browser dark mode and brightness. Use
# DAYLIGHT_SCHEDULE="sun" with latitude/longitude for real sunrise/sunset,
# or DAYLIGHT_SCHEDULE="fixed" for the HH:MM fallback times.
DAYLIGHT_SCHEDULE="fixed"
DAYLIGHT_LIGHT_START="07:00"
DAYLIGHT_DARK_START="19:00"
# DAYLIGHT_TIMEZONE="America/New_York"
# DAYLIGHT_LATITUDE="40.7128"
# DAYLIGHT_LONGITUDE="-74.0060"
# Optional offsets from real sunrise/sunset when DAYLIGHT_SCHEDULE="sun".
DAYLIGHT_SUNRISE_OFFSET_MIN=0
DAYLIGHT_SUNSET_OFFSET_MIN=0

# Sensor + screen behavior tuning.
# Trigger wake when someone is closer than this.
DISTANCE_THRESHOLD_MM=1500
# Blank screen after this many seconds without motion.
INACTIVITY_TIMEOUT_SEC=90
# Absolute minimum brightness value.
BRIGHTNESS_MIN=10
# Absolute maximum brightness value.
BRIGHTNESS_MAX=255
# Lux at which we clamp to BRIGHTNESS_MAX.
BRIGHTNESS_LUX_MAX=400
# Used when the light sensor is unavailable.
DEFAULT_BRIGHTNESS=120
# Override brightness by the day/night schedule, useful when sensors are absent.
BRIGHTNESS_SCHEDULE=true
DAY_BRIGHTNESS=120
NIGHT_BRIGHTNESS=35

# Home Assistant PIR presence. Prefer the local LAN URL for low latency.
HA_API_BASE_URL="http://homeassistant.local:8123"
HA_ACCESS_TOKEN=""
HA_MOTION_ENTITY_ID="binary_sensor.kiosk_motion_sensor"
HA_MOTION_POLL_INTERVAL_SEC=0.5
PRESENCE_HOLD_SEC=180
# Touch/input devices that should also wake the kiosk. Raspberry Pi touchscreen
# usually appears as /dev/input/event1.
INPUT_ACTIVITY_DEVICES="/dev/input/event1"

# Idle mode keeps Chromium running but blanks the X screen and dims the panel.
ENABLE_IDLE_SCREENSAVER=true
IDLE_BRIGHTNESS=10
BRIGHTNESS_FADE_WAKE_SEC=0.4
BRIGHTNESS_FADE_IDLE_SEC=3.0

# Optional f.lux-style gamma warming through xrandr.
ENABLE_BLUE_LIGHT_REDUCTION=true
XRANDR_OUTPUT="DSI-2"
GAMMA_DAY="1.0:1.0:1.0"
GAMMA_NIGHT="1.0:0.88:0.65"
GAMMA_IDLE="1.0:0.78:0.45"

# Display control helpers.
BRIGHTNESSCTL_BIN="/usr/bin/brightnessctl"
BRIGHTNESSCTL_DEVICE="11-0045"
# Uncomment to bypass brightnessctl and write directly to a specific backlight file.
# BACKLIGHT_PATH="/sys/class/backlight/11-0045/brightness"

# Poll cadence for sensor loop (seconds).
POLL_INTERVAL_SEC=0.5

# Logging detail: DEBUG, INFO, WARNING, ERROR. Set LOG_JSON=true to emit structured logs.
LOG_LEVEL="INFO"
LOG_JSON=false

# Toggle individual sensors if hardware is absent.
ENABLE_DISTANCE_SENSOR=true
ENABLE_LIGHT_SENSOR=true

# Remote viewing via VNC. Set to true to enable x11vnc service that mirrors the kiosk.
ENABLE_VNC=false
VNC_PORT=5900
# Path to an x11vnc password file (create with: sudo -u kiosk x11vnc -storepasswd /etc/pi-kiosk/x11vnc.pass).
VNC_PASSWORD_FILE=""
# Extra arguments to pass to x11vnc.
VNC_EXTRA_ARGS="-shared -loop"

# Local network discovery via mDNS/Bonjour. Avahi publishes the host as
# <hostname>.local and advertises enabled services via Bonjour.
ENABLE_MDNS=true
MDNS_NAME="Pi Kiosk"
MDNS_ADVERTISE_SSH=true
MDNS_ADVERTISE_VNC=true
